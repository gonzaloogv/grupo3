# Copiar como .env y completar solo en el entorno local.
# Nunca versionar tokens ni claves reales.
APP_TIME_ZONE=America/Argentina/Buenos_Aires
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DEMO_API_TOKEN=replace-with-a-long-random-token

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000
PROMPT_VERSION=freno-v1

# Google Safe Browsing Lookup API. Crear una clave restringida en Google Cloud
# y habilitar Safe Browsing API para el proyecto; nunca versionar la clave real.
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_TIMEOUT_MS=1500
SAFE_BROWSING_MAX_URLS=3

ANALYSIS_CACHE_TTL_MINUTES=15
ANALYSIS_CACHE_MAX_ENTRIES=100
MAX_REQUEST_BODY_BYTES=8192
MAX_TEXT_CHARS=2000
LOG_LEVEL=INFO
