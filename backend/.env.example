# Copiar como .env y completar solo en el entorno local.
# Nunca versionar tokens ni claves reales.
APP_TIME_ZONE=America/Argentina/Buenos_Aires
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DEMO_API_TOKEN=replace-with-a-long-random-token

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=5000
PROMPT_VERSION=freno-v1

# PhishTank publica el feed verificado/activo cada hora. La app key evita
# el límite bajo de descargas anónimas y el User-Agent debe ser descriptivo.
PHISHTANK_ENABLED=true
PHISHTANK_APP_KEY=
PHISHTANK_USER_AGENT=phishtank/freno-hackathon
PHISHTANK_REFRESH_MINUTES=60

ANALYSIS_CACHE_TTL_MINUTES=15
ANALYSIS_CACHE_MAX_ENTRIES=100
MAX_REQUEST_BODY_BYTES=8192
MAX_TEXT_CHARS=2000
LOG_LEVEL=INFO
